      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const nodoArchivo = $(\"Descargar Archivo\").item;\nconst bin = nodoArchivo.binary || {};\n\nconst e = $(\"Evaluar Rol\").item.json;\nconst n = $(\"Normalizar y Clasificar\").item.json;\n\nreturn {\n  json: {\n    userId: n.userId,\n    username: e.username,\n    chatId: n.chatId,\n    fileName: n.fileName,\n    extension: n.extension,\n    sha256: $json.sha256,\n    fileBase64: bin.data ? bin.data.data : \"\",\n  },\n  binary: bin,  // pasa el objeto binary completo al siguiente nodo\n};\n"
