    {
      "parameters": {
        "jsCode": "const analysis = $json.data.attributes;\nconst stats = analysis.stats;\n\n// Cuántos motores detectaron algo malicioso\nconst malicious = stats.malicious || 0;\nconst suspicious = stats.suspicious || 0;\nconst total = stats.harmless + stats.malicious + stats.suspicious + stats.undetected;\n\n// Determinar nivel de riesgo\nlet riskLevel;\nlet verdict;\n\nif (malicious > 5) {\n  riskLevel = \"CRÍTICO\";\n  verdict = \"MALWARE CONFIRMADO\";\n} else if (malicious > 0 || suspicious > 3) {\n  riskLevel = \"ALTO\";\n  verdict = \"SOSPECHOSO\";\n} else {\n  riskLevel = \"MEDIO\";\n  verdict = \"LIMPIO - pero hash cambió\";\n}\n\nconst p = $(\"Comparar Integridad\").item.json;\n\nreturn {\n  json: {\n    userId: p.userId,\n    username: p.username,\n    chatId: p.chatId,\n    fileName: p.fileName,\n    sha256: p.sha256,\n    prevHash: p.prevHash,\n    integrityStatus: p.integrityStatus,\n    riskLevel: riskLevel,\n    verdict: verdict,\n    maliciousEngines: malicious,\n    suspiciousEngines: suspicious,\n    totalEngines: total,\n    vtAnalysisId: $json.data.id,\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
