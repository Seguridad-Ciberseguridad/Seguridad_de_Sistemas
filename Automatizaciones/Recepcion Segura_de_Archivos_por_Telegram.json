      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = $json || {};\nconst prev = row.sha256 || \"\";\n\nconst p = $(\"Preparar Archivo\").item.json;\nconst bin = $(\"Preparar Archivo\").item.binary || {};\nconst current = p.sha256;\n\nlet integrityStatus;\nlet riskLevel;\n\nif (!prev) { integrityStatus = \"OK\"; riskLevel = \"NUEVO\"; }\nelse if (prev === current) { integrityStatus = \"OK\"; riskLevel = \"BAJO\"; }\nelse { integrityStatus = \"INTEGRIDAD COMPROMETIDA\"; riskLevel = \"ALTO\"; }\n\nreturn {\n  json: {\n    userId: p.userId,\n    username: p.username,\n    chatId: p.chatId,\n    fileName: p.fileName,\n    extension: p.extension,\n    sha256: current,\n    prevHash: prev,\n    fileBase64: p.fileBase64,\n    integrityStatus,\n    riskLevel,\n  },\n  binary: bin,  // ← rescata el binario de Preparar Archivo\n};\n"
      },
