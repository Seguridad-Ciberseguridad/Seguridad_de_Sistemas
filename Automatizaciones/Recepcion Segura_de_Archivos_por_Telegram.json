      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const msg = $json.message || {};\nconst from = msg.from || {};\nconst chat = msg.chat || {};\nconst doc = msg.document || {};\n\n// Extensiones consideradas peligrosas\nconst dangerousExtensions = ['exe','bat','cmd','com','scr','js','vbs','msi','jar','ps1','sh','dll','apk','pif','reg'];\n\nconst fileName = doc.file_name || '';\nconst parts = fileName.split('.');\nconst extension = parts.length > 1 ? parts[parts.length - 1].toLowerCase() : '';\nconst userId = from.id;\n\nreturn {\n  json: {\n    userId: userId,\n    username: from.first_name || '',\n    chatId: chat.id,\n    fileId: doc.file_id || '',\n    fileName: fileName,\n    fileSize: doc.file_size || 0,\n    mimeType: doc.mime_type || '',\n    extension: extension,\n    hasFile: Boolean(doc.file_id),\n    isDangerous: dangerousExtensions.includes(extension),\n  },\n};"
      },
      "id": "27abfab0-0c45-4a0f-8889-36a5c2e212ff",
