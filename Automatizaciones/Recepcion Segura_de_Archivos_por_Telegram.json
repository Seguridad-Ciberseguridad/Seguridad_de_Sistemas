        "jsCode": "const row = $json || {};\nconst n = $(\"Normalizar y Clasificar\").item.json;\nconst role = (row.rol || \"\").toString().toLowerCase();\nconst isAdmin = role === \"admin\";\nconst username = row.nombre;\nreturn {\n  json: {\n    userId: n.userId,\n    username: username,\n    chatId: n.chatId,\n    fileId: n.fileId,\n    fileName: n.fileName,\n    fileSize: n.fileSize,\n    mimeType: n.mimeType,\n    extension: n.extension,\n    hasFile: n.hasFile,\n    isDangerous: n.isDangerous,\n    role: role || \"(sin rol)\",\n    isAuthorized: isAdmin,\n  },\n};"
